prometheus.scrape "vllm" {
  targets = [
    {
      "__address__" = "__METRICS_SCRAPE_TARGET__",
      "job"         = "__METRICS_PIPELINE_NAME__",
    },
  ]
  metrics_path    = "__METRICS_SCRAPE_PATH__"
  scrape_interval = "__METRICS_SCRAPE_INTERVAL__"
  scrape_timeout  = "__METRICS_SCRAPE_TIMEOUT__"
  forward_to      = __METRICS_FORWARD_TO__
}

otelcol.receiver.prometheus "vllm" {
  output {
    metrics = [otelcol.processor.batch.vllm.input]
  }
}

otelcol.processor.batch "vllm" {
  output {
    metrics = [otelcol.exporter.otlphttp.vllm.input]
  }
}

otelcol.exporter.otlphttp "vllm" {
  encoding = "proto"
  client {
    endpoint    = "__METRICS_OTLP_HTTP_ENDPOINT__"
    compression = "__METRICS_OTLP_COMPRESSION__"
    timeout     = "__METRICS_OTLP_TIMEOUT__"
    tls {
      insecure             = __METRICS_OTLP_INSECURE__
      insecure_skip_verify = __METRICS_OTLP_INSECURE_SKIP_VERIFY__
    }
  }
}

otelcol.receiver.filelog "worker" {
  include  = __LOGS_FILE_INCLUDE__
  start_at = "end"

  output {
    logs = __LOGS_RECEIVER_OUTPUT__
  }
}

otelcol.processor.resource "worker_logs" {
  attributes {
    action = "upsert"
    key    = "service.name"
    value  = "worker-vllm"
  }

  attributes {
    action = "upsert"
    key    = "service.namespace"
    value  = "runpod-workers"
  }

  attributes {
    action = "upsert"
    key    = "telemetry.signal"
    value  = "logs"
  }

  output {
    logs = [otelcol.processor.batch.worker_logs.input]
  }
}

otelcol.processor.batch "worker_logs" {
  output {
    logs = [otelcol.exporter.otlphttp.worker_logs.input]
  }
}

otelcol.exporter.otlphttp "worker_logs" {
  encoding = "proto"
  client {
    endpoint    = "__LOGS_OTLP_HTTP_ENDPOINT__"
    compression = "__LOGS_OTLP_COMPRESSION__"
    timeout     = "__LOGS_OTLP_TIMEOUT__"
    tls {
      insecure             = __LOGS_OTLP_INSECURE__
      insecure_skip_verify = __LOGS_OTLP_INSECURE_SKIP_VERIFY__
    }
  }
}
